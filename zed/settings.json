// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "base_keymap": "VSCode",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "status_bar": {
    "line_endings_button": true
  },
  "sticky_scroll": {
    "enabled": true
  },
  "wrap_guides": [80],
  "soft_wrap": "none",
  "format_on_save": "on",
  "file_types": {
    "JSON": ["jsonl"]
  },
  "languages": {
    "JSON": {
      "soft_wrap": "none"
    },
    "TypeScript": {
      "format_on_save": "on",
      "formatter": "prettier",
      "prettier": {
        "allowed": true
      }
    },
    "CSharp": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "csharpier",
          "arguments": [
            "format",
            "--write-stdout",
            "--stdin-path",
            "{buffer_path}"
          ]
        }
      }
    },
    "Markdown": {
      "format_on_save": "on",
      "remove_trailing_whitespace_on_save": true,
      "formatter": "prettier",
      "prettier": {
        "allowed": true,
        "printWidth": 80,
        "proseWrap": "always"
      }
    }
  },
  "formatter": "language_server",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right"
  },
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "system",
    "light": "Ayu Mirage",
    "dark": "Ayu Dark"
  }
}
