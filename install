#!/usr/bin/env bash
# Dotfiles bootstrap installer
# This script installs Deno if needed, then runs the TypeScript installer
set -euo pipefail

REPO_URL="${DOTFILES_REPO:-https://github.com/marknorgren/dotfiles-public.git}"
TARGET_DIR="${DOTFILES_TARGET:-$HOME/.dotfiles-public}"

# Deno version this repo is developed and tested against. `deno fmt` output
# changes between minor versions, so an unpinned bootstrap lets a fresh machine
# format code that the pinned CI gate then rejects. Keep this on the same line
# as deno-version in .github/workflows/ci.yml; a test enforces that.
DENO_VERSION="v2.8.3"
MIN_FREE_KB="${DOTFILES_MIN_FREE_KB:-8388608}"
DRY_RUN=0
for arg in "$@"; do
    if [[ "$arg" == "--dry-run" || "$arg" == "-n" ]]; then
        DRY_RUN=1
        break
    fi
done

script_path="${BASH_SOURCE[0]:-}"
if [[ -z "$script_path" || ! -f "$script_path" ]]; then
    DOTFILES_DIR="$PWD"
else
    DOTFILES_DIR="$(cd "$(dirname "$script_path")" && pwd)"
fi

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[0;33m'
BOLD='\033[1m'
NC='\033[0m'

log_info() { echo -e "${BLUE}ℹ${NC} $1"; }
log_success() { echo -e "${GREEN}✓${NC} $1"; }
log_warn() { echo -e "${YELLOW}⚠${NC} $1"; }
log_error() { echo -e "${RED}✗${NC} $1" >&2; }
log_header() { echo -e "\n${BOLD}▸ $1${NC}"; }

# Detect platform
detect_platform() {
    case "$(uname -s)" in
        Darwin) echo "macos" ;;
        Linux) echo "linux" ;;
        *) echo "unknown" ;;
    esac
}

read_deno_version() {
    local version_line

    if ! version_line="$("$1" --version 2>/dev/null | head -1)" || [[ "$version_line" != deno\ * ]]; then
        return 1
    fi
    printf '%s\n' "$version_line"
}

# Install Deno if not present or unusable
install_deno() {
    local deno_bin
    local installed_version
    local standalone_deno="$HOME/.deno/bin/deno"
    local supported_line
    local version_line

    deno_bin="$(command -v deno || true)"
    if [[ -n "$deno_bin" ]] && version_line="$(read_deno_version "$deno_bin")"; then
        installed_version="${version_line#deno }"
        installed_version="${installed_version%% *}"
        supported_line="${DENO_VERSION#v}"
        supported_line="${supported_line%.*}"
        log_info "Deno already installed: $version_line"
        if [[ "$installed_version" != "$supported_line".* ]]; then
            log_warn "Deno $installed_version does not match the supported $supported_line release line"
            log_info "Fresh installs use $DENO_VERSION to match CI formatting"
        fi
        return 0
    fi
    if [[ -n "$deno_bin" ]]; then
        log_warn "Existing Deno is unusable: $deno_bin"
        log_info "Installing the pinned standalone Deno release instead"
    fi

    if [[ -x "$standalone_deno" ]] && version_line="$(read_deno_version "$standalone_deno")"; then
        export PATH="$HOME/.deno/bin:$PATH"
        log_info "Deno already installed: $version_line"
        return 0
    fi

    log_header "Installing Deno"
    ensure_deno_archive_tool

    # The official installer takes the version as its first positional
    # argument. It is used on both platforms rather than `brew install deno` on
    # macOS, because Homebrew always installs the current release and would
    # defeat the pin. Nothing else in this repo expects a brew-managed Deno.
    log_info "Installing Deno $DENO_VERSION..."
    curl -fsSL https://deno.land/install.sh |
        CI=1 sh -s -- --no-modify-path "$DENO_VERSION"
    export PATH="$HOME/.deno/bin:$PATH"

    if ! version_line="$(read_deno_version "$standalone_deno")"; then
        log_error "Deno installation did not produce a working executable at $standalone_deno"
        return 1
    fi
    log_success "Deno installed: $version_line"
}

homebrew_path() {
    if [[ -n "${DOTFILES_HOMEBREW_PATH:-}" ]]; then
        printf '%s\n' "$DOTFILES_HOMEBREW_PATH"
    elif command -v brew &>/dev/null; then
        command -v brew
    elif [[ -x /opt/homebrew/bin/brew ]]; then
        printf '%s\n' /opt/homebrew/bin/brew
    elif [[ -x /usr/local/bin/brew ]]; then
        printf '%s\n' /usr/local/bin/brew
    fi
}

check_storage_path() {
    local path="$1"
    local available_kb
    local probe

    [[ -d "$path" ]] || return 0
    available_kb="$(df -Pk "$path" 2>/dev/null | awk 'END {print $4}')"
    if [[ ! "$available_kb" =~ ^[0-9]+$ ]]; then
        log_error "Cannot determine free space for $path"
        return 1
    fi
    if ((available_kb < MIN_FREE_KB)); then
        log_error "Insufficient free space at $path: $((available_kb / 1024 / 1024)) GiB available; $((MIN_FREE_KB / 1024 / 1024)) GiB required"
        log_info "Free space or expand the VM disk, then rerun the installer"
        return 1
    fi

    if ((DRY_RUN == 0)); then
        if ! probe="$(mktemp "${path%/}/.dotfiles-install.XXXXXX")"; then
            log_error "Cannot write to $path"
            return 1
        fi
        if ! LC_ALL=C /bin/rm -f "$probe"; then
            log_error "Cannot remove storage probe: $probe"
            return 1
        fi
    fi
}

preflight_storage() {
    local brew
    local prefix
    local temp_dir="${TMPDIR:-/private/tmp}"

    if [[ ! "$MIN_FREE_KB" =~ ^[0-9]+$ ]]; then
        log_error "DOTFILES_MIN_FREE_KB must be a non-negative integer"
        return 1
    fi

    log_header "Checking storage"
    check_storage_path "$HOME"
    check_storage_path "$temp_dir"
    if [[ "$(detect_platform)" == "macos" && "$temp_dir" != "/private/tmp" ]]; then
        check_storage_path "/private/tmp"
    fi

    brew="$(homebrew_path)"
    if [[ -n "$brew" ]]; then
        prefix="$(cd "$(dirname "$brew")/.." && pwd)"
        check_storage_path "$prefix"
    fi

    log_success "Storage preflight passed"
}

run_as_root() {
    if [[ "$(id -u)" == "0" ]]; then
        "$@"
    else
        sudo "$@"
    fi
}

ensure_deno_archive_tool() {
    if command -v unzip &>/dev/null || command -v 7z &>/dev/null; then
        return 0
    fi

    if [[ "$(detect_platform)" != "linux" ]]; then
        log_error "Deno installer requires unzip or 7z"
        exit 1
    fi

    log_info "Installing unzip for the Deno installer..."
    if command -v apt-get &>/dev/null; then
        run_as_root apt-get update
        run_as_root apt-get install -y unzip
    elif command -v dnf &>/dev/null; then
        run_as_root dnf install -y unzip
    else
        log_error "Install unzip or 7z, then rerun this script"
        exit 1
    fi
}

# Install Xcode Command Line Tools (macOS only)
install_xcode_cli() {
    if [[ "$(detect_platform)" != "macos" ]]; then
        return 0
    fi

    if xcode-select -p &>/dev/null; then
        log_info "Xcode Command Line Tools already installed"
        return 0
    fi

    log_header "Installing Xcode Command Line Tools"
    log_info "A dialog will appear - click 'Install' to continue"
    xcode-select --install

    # Wait for installation
    until xcode-select -p &>/dev/null; do
        sleep 5
    done
    log_success "Xcode Command Line Tools installed"
}

# When this script is run via curl, clone the repo first, then re-run locally.
bootstrap_repo_if_needed() {
    if [[ -f "$DOTFILES_DIR/scripts/install.ts" ]]; then
        return 0
    fi

    log_header "Bootstrapping dotfiles repository"

    if ! command -v git &>/dev/null; then
        log_error "git is required before the dotfiles repo can be cloned"
        if [[ "$(detect_platform)" == "linux" ]]; then
            log_info "Install git with your distro package manager, then rerun this script"
        fi
        exit 1
    fi

    if [[ -d "$TARGET_DIR/.git" ]]; then
        log_info "Updating existing checkout: $TARGET_DIR"
        git -C "$TARGET_DIR" pull --ff-only
    elif [[ -e "$TARGET_DIR" ]]; then
        log_error "$TARGET_DIR already exists and is not a git checkout"
        log_info "Set DOTFILES_TARGET to another directory or move the existing path"
        exit 1
    else
        log_info "Cloning $REPO_URL to $TARGET_DIR"
        git clone "$REPO_URL" "$TARGET_DIR"
    fi

    exec /usr/bin/env bash "$TARGET_DIR/install" "$@"
}

# Main
main() {
    echo -e "${BOLD}Dotfiles Installer${NC}"
    echo "=================="
    echo

    if [[ -f "$DOTFILES_DIR/scripts/install.ts" ]]; then
        log_info "Dotfiles directory: $DOTFILES_DIR"
    else
        log_info "Bootstrap source: remote"
    fi
    log_info "Platform: $(detect_platform)"

    preflight_storage

    # macOS: ensure Xcode CLI tools
    install_xcode_cli

    # Remote one-liner mode: clone/update first, then continue from checkout.
    bootstrap_repo_if_needed "$@"

    # Install Deno
    install_deno

    # Run the TypeScript installer
    log_header "Running installer"

    # Ensure deno is in PATH
    if ! command -v deno &>/dev/null; then
        export PATH="$HOME/.deno/bin:$PATH"
    fi

    cd "$DOTFILES_DIR"
    export DOTFILES="$DOTFILES_DIR"
    deno_cmd=(
        deno run
        --allow-read
        --allow-write
        --allow-run
        --allow-env
        scripts/install.ts
    )

    if [[ -r /dev/tty ]] && { : </dev/tty; } 2>/dev/null; then
        "${deno_cmd[@]}" "$@" </dev/tty
    else
        "${deno_cmd[@]}" "$@"
    fi
}

main "$@"
