#!/usr/bin/env bash
set -euo pipefail

if [[ "$(uname -s)" != "Darwin" ]]; then
    printf 'setup-macos only runs on macOS.\n' >&2
    exit 69
fi

DRY_RUN=false
DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

case "${1:-}" in
    "")
        ;;
    --dry-run)
        DRY_RUN=true
        ;;
    --help | -h)
        printf 'Usage: %s [--dry-run]\n' "$0"
        exit 0
        ;;
    *)
        printf 'Usage: %s [--dry-run]\n' "$0" >&2
        exit 64
        ;;
esac

run() {
    if [[ "$DRY_RUN" == "true" ]]; then
        printf '+'
        printf ' %q' "$@"
        printf '\n'
    else
        "$@"
    fi
}

restart_process() {
    if [[ "$DRY_RUN" == "true" ]]; then
        printf '+ killall %q\n' "$1"
    else
        killall "$1" &>/dev/null || true
    fi
}

configure_finder_path_button() {
    if [[ "$DRY_RUN" == "true" ]]; then
        printf '+ add com.apple.finder.PATH to the existing Finder toolbar\n'
        return
    fi

    local preferences_file toolbar_items
    preferences_file="$(mktemp "${TMPDIR:-/tmp}/dotfiles-finder.XXXXXX.plist")"

    if ! defaults export com.apple.finder "$preferences_file" >/dev/null; then
        rm -f "$preferences_file"
        return 1
    fi

    toolbar_items="$(
        plutil -extract 'NSToolbar Configuration Browser.TB Item Identifiers' \
            json -o - "$preferences_file" 2>/dev/null || true
    )"
    if [[ "$toolbar_items" == *'"com.apple.finder.PATH"'* ]]; then
        rm -f "$preferences_file"
        return
    fi

    if ! plutil -extract 'NSToolbar Configuration Browser' xml1 -o /dev/null \
        "$preferences_file" 2>/dev/null; then
        plutil -insert 'NSToolbar Configuration Browser' -dictionary "$preferences_file"
    fi

    if [[ -n "$toolbar_items" ]]; then
        plutil -insert 'NSToolbar Configuration Browser.TB Item Identifiers.1' \
            -string 'com.apple.finder.PATH' "$preferences_file"
    else
        plutil -insert 'NSToolbar Configuration Browser.TB Item Identifiers' \
            -json '["com.apple.finder.BACK","com.apple.finder.PATH","com.apple.finder.SWCH","NSToolbarSpaceItem","com.apple.finder.ARNG","NSToolbarSpaceItem","com.apple.finder.SHAR","com.apple.finder.LABL","com.apple.finder.ACTN","NSToolbarSpaceItem","com.apple.finder.SRCH"]' \
            "$preferences_file"
    fi

    if ! defaults import com.apple.finder "$preferences_file" >/dev/null; then
        rm -f "$preferences_file"
        return 1
    fi
    rm -f "$preferences_file"
}

configure_finder_favorites() {
    local helper

    if [[ "$DRY_RUN" == "true" ]]; then
        printf '+ xcrun clang -fobjc-arc -framework Foundation %q -o <temporary-helper>\n' \
            "$DOTFILES_DIR/scripts/finder-sidebar.m"
        printf '+ <temporary-helper>\n'
        return
    fi

    helper="$(mktemp "${TMPDIR:-/tmp}/dotfiles-finder-sidebar.XXXXXX")"
    if ! xcrun clang -fobjc-arc -framework Foundation \
        "$DOTFILES_DIR/scripts/finder-sidebar.m" -o "$helper"; then
        rm -f "$helper"
        return 1
    fi
    if ! "$helper"; then
        rm -f "$helper"
        return 1
    fi
    rm -f "$helper"
}

###############################################################################
# Essential Settings                                                           #
###############################################################################

echo "Configuring essential settings..."

# Create Books directory if it doesn't exist
run mkdir -p "$HOME/Documents/Books"

# Create the standard workspace directory
run mkdir -p "$HOME/working"

# Set system locale and currency settings
run defaults write NSGlobalDomain AppleLocale -string "en_US"
run defaults write NSGlobalDomain AppleMeasurementUnits -string "Inches"
run defaults write NSGlobalDomain AppleMetricUnits -bool false
run defaults write NSGlobalDomain AppleTemperatureUnit -string "Fahrenheit"
run defaults write NSGlobalDomain AppleICUDateFormatStrings -dict-add "1" "M/d/yy"
run defaults write NSGlobalDomain AppleICUDateFormatStrings -dict-add "2" "MMM d, y"
run defaults write NSGlobalDomain AppleICUDateFormatStrings -dict-add "3" "MMMM d, y"
run defaults write NSGlobalDomain AppleICUDateFormatStrings -dict-add "4" "EEEE, MMMM d, y"

# Set mouse and trackpad tracking speed to 2.1
run defaults write NSGlobalDomain com.apple.mouse.scaling -float 2.1
run defaults write NSGlobalDomain com.apple.trackpad.scaling -float 2.1

# Set Dark mode
run defaults write NSGlobalDomain AppleInterfaceStyle -string "Dark"

# Trackpad settings
run defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad Clicking -bool true
run defaults write com.apple.AppleMultitouchTrackpad Clicking -bool true
run defaults write com.apple.AppleMultitouchTrackpad TrackpadThreeFingerDrag -bool true
run defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadThreeFingerDrag -bool true

# Show battery percentage
run defaults write com.apple.controlcenter BatteryShowPercentage -bool true
run defaults write com.apple.controlcenter "NSStatusItem Visible Battery" -bool true

###############################################################################
# Finder                                                                      #
###############################################################################

echo "Configuring Finder..."

# Show all file extensions
run defaults write NSGlobalDomain AppleShowAllExtensions -bool true

# Show path bar and status bar
run defaults write com.apple.finder ShowPathbar -bool true
run defaults write com.apple.finder ShowStatusBar -bool true

# Add the Path button without replacing the user's other toolbar items
configure_finder_path_button

# Keep Home first and ~/working second in Finder Favorites
configure_finder_favorites

# Keep folders on top when sorting by name
run defaults write com.apple.finder _FXSortFoldersFirst -bool true

# Avoid creating .DS_Store files on network or USB volumes
run defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true
run defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true

# Show hidden files
run defaults write com.apple.finder AppleShowAllFiles -bool true

# Use list view in all Finder windows
run defaults write com.apple.finder FXPreferredViewStyle -string "Nlsv"

###############################################################################
# Dock                                                                        #
###############################################################################

echo "Configuring Dock..."

# Auto-hide the Dock
run defaults write com.apple.dock autohide -bool true

# Remove the auto-hiding delay
run defaults write com.apple.dock autohide-delay -float 0
run defaults write com.apple.dock autohide-time-modifier -float 0.5

# Don't show recent applications in Dock
run defaults write com.apple.dock show-recents -bool false

###############################################################################
# Keyboard                                                                    #
###############################################################################

echo "Configuring keyboard settings..."

# Set a fast keyboard repeat rate
run defaults write NSGlobalDomain KeyRepeat -int 2
run defaults write NSGlobalDomain InitialKeyRepeat -int 15

# Disable automatic capitalization and other substitutions
run defaults write NSGlobalDomain NSAutomaticCapitalizationEnabled -bool false
run defaults write NSGlobalDomain NSAutomaticPeriodSubstitutionEnabled -bool false
run defaults write NSGlobalDomain NSAutomaticQuoteSubstitutionEnabled -bool false
run defaults write NSGlobalDomain NSAutomaticSpellingCorrectionEnabled -bool false
run defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool false
run defaults write NSGlobalDomain AppleShowScrollBars -string "Always"

###############################################################################
# Kill affected applications                                                  #
###############################################################################

echo "Restarting affected applications..."

# Kill all potentially affected processes
for app in "Dock" "Finder" "SystemUIServer" "cfprefsd"; do
    restart_process "${app}"
done

echo "macOS settings updated. Some changes may require logout or restart."
